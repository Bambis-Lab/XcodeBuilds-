{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bambis-Lab project registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projects"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "platforms",
          "profile",
          "source_repository",
          "source_path",
          "signing",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "description": {
            "type": "string"
          },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "ios",
                "ipados",
                "macos",
                "watchos",
                "tvos",
                "visionos",
                "swift-package"
              ]
            }
          },
          "profile": {
            "enum": [
              "ios",
              "macos",
              "watchos",
              "tvos",
              "visionos",
              "swift-package"
            ]
          },
          "source_repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "source_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "signing": {
            "const": "disabled"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
